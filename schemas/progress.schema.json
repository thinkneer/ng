{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "progress.schema.json",
  "title": "Synced progress for one nickname (data/progress/<nickname>.json). Written only by the sync Action.",
  "type": "object",
  "required": ["nickname", "version", "synced_on"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "nickname": { "type": "string", "pattern": "^[A-Za-z0-9_]{3,20}$" },
    "version": { "type": "integer", "minimum": 1 },
    "synced_on": { "type": "string" },
    "class": { "type": "string" },
    "stream": { "type": "string" },
    "subjects": { "type": "array", "items": { "type": "string" } },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "school_day_hours": { "type": "number" },
        "holiday_hours": { "type": "number" },
        "study_leave_start": { "type": "string", "format": "date" },
        "start_date": { "type": "string", "format": "date" },
        "weak_chapters": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "school_dates": { "type": "object" }
      }
    },
    "tracker": {
      "type": "object",
      "description": "key: <subject>/<chapter-id>",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "L": { "type": "boolean" }, "R1": { "type": "boolean" }, "PYQ": { "type": "boolean" },
          "R2": { "type": "boolean" }, "E": { "type": "boolean" },
          "confidence": { "type": "integer", "minimum": 1, "maximum": 5 },
          "updated": { "type": "string" }
        }
      }
    },
    "plan_ticks": {
      "type": "object",
      "description": "key: ISO date → ticked block indexes and actual hours",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "done": { "type": "array", "items": { "type": "integer" } },
          "actual_hours": { "type": "number" },
          "note": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "subject", "date", "score", "max"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "subject": { "type": "string" },
          "scope": { "type": "string" },
          "date": { "type": "string" },
          "score": { "type": "number" },
          "max": { "type": "number" },
          "minutes": { "type": "number" },
          "wrong": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "updated": { "type": "string" },
    "recall": {
      "type": "object",
      "description": "key: card id → Leitner state",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "box": { "type": "integer" }, "due": { "type": "string", "format": "date" }, "seen": { "type": "integer" }, "last": { "type": "string" }, "key": { "type": "string" }, "got": { "type": "integer" }, "again": { "type": "integer" } }
      }
    },
    "highlights": {
      "type": "object",
      "description": "key: <subject>/<chapter>/<layer> → { id → highlight }",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": ["id", "layer", "chunk", "exact", "color"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" }, "layer": { "type": "string" }, "chunk": { "type": "integer" },
            "exact": { "type": "string", "maxLength": 2000 }, "prefix": { "type": "string" }, "suffix": { "type": "string" },
            "color": { "enum": ["yellow", "green", "blue", "pink", "purple"] },
            "note": { "type": "string", "maxLength": 2000 }, "created": { "type": "string" }, "updated": { "type": "string" }
          }
        }
      }
    },
    "mistakes": { "type": "array", "items": { "type": "string" }, "description": "question ids" },
    "bookmarks": { "type": "array", "items": { "type": "string" } },
    "my_notes": {
      "type": "object",
      "description": "key: <subject>/<chapter-id> → the student's own text",
      "additionalProperties": { "type": "string", "maxLength": 20000 }
    },
    "papers": {
      "type": "array",
      "description": "Exam mode: full papers sat on this device",
      "items": {
        "type": "object",
        "required": ["subject", "id"],
        "additionalProperties": false,
        "properties": {
          "subject": { "type": "string" }, "id": { "type": "string" }, "minutes": { "type": "number" }, "early": { "type": "boolean" }, "at": { "type": "string" },
          "code": { "type": "string" }, "refs": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
          "marks": { "type": "array", "items": { "type": "number" } }, "score": { "type": "number" }, "out_of": { "type": "number" }, "marked_code": { "type": "string" }, "marked_at": { "type": "string" }
        }
      }
    }
  }
}
