{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "exams.schema.json",
  "title": "Board exam dates for one class and year (data/exams/<class>-<year>.json)",
  "type": "object",
  "required": ["class", "board_year", "source", "date_checked", "papers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "class": { "type": "string", "enum": ["10", "12"] },
    "board_year": { "type": "integer", "minimum": 2026 },
    "source": { "type": "string" },
    "date_checked": { "type": "string", "format": "date" },
    "recheck_note": { "type": "string" },
    "papers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["subject", "name", "date"],
        "additionalProperties": false,
        "properties": {
          "subject": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "start": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
          "duration_minutes": { "type": "integer" }
        }
      }
    },
    "practical_window": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" },
        "note": { "type": "string" }
      }
    }
  }
}
