{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "classes.schema.json",
  "title": "Classes, streams and subjects",
  "type": "object",
  "required": ["classes"],
  "properties": {
    "$schema": { "type": "string" },
    "updated": { "type": "string", "format": "date" },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "board_year", "status", "streams"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "enum": ["9", "10", "11", "12"] },
          "name": { "type": "string" },
          "board_year": { "type": "boolean" },
          "status": { "$ref": "#/definitions/status" },
          "streams": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "name", "status", "subjects"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "name": { "type": "string" },
                "status": { "$ref": "#/definitions/status" },
                "subjects": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["id", "name", "short", "status"],
                    "additionalProperties": false,
                    "properties": {
                      "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                      "name": { "type": "string" },
                      "short": { "type": "string", "maxLength": 12 },
                      "code": { "type": "string" },
                      "status": { "$ref": "#/definitions/status" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "status": { "type": "string", "enum": ["live", "coming-soon"] }
  }
}
