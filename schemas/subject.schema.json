{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "subject.schema.json",
  "title": "Subject (one per /content/<class>/<stream>/<subject>/subject.json)",
  "type": "object",
  "required": ["id", "name", "class", "stream", "syllabus_year", "theory_marks", "internal_marks", "duration_minutes", "colour", "units"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string" },
    "code": { "type": "string" },
    "class": { "type": "string", "enum": ["9", "10", "11", "12"] },
    "stream": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "syllabus_year": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}$" },
    "theory_marks": { "type": "integer", "minimum": 1 },
    "internal_marks": { "type": "integer", "minimum": 0 },
    "internal_note": { "type": "string" },
    "duration_minutes": { "type": "integer", "minimum": 30 },
    "exam_date": { "type": "string", "format": "date" },
    "colour": { "$ref": "#/definitions/hex" },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "colour", "marks", "chapters"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "colour": { "$ref": "#/definitions/hex" },
          "marks": { "type": "integer", "minimum": 0 },
          "marks_group": { "type": "string", "description": "When CBSE gives one mark total for several units, name the group here." },
          "chapters": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "number", "title"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                "number": { "type": "integer", "minimum": 1 },
                "title": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "not_in_syllabus": { "type": "array", "items": { "type": "string" } },
    "content_note": { "type": "string" },
    "links": {
      "type": "object",
      "additionalProperties": { "type": "string", "format": "uri" }
    }
  },
  "definitions": {
    "hex": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" }
  }
}
