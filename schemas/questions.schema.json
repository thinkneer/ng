{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "questions.schema.json",
  "title": "Question bank (questions.json inside a chapter folder)",
  "type": "array",
  "items": { "$ref": "#/definitions/question" },
  "definitions": {
    "question": {
      "type": "object",
      "required": ["id", "chapter", "type", "marks", "stars", "label", "stem"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "chapter": { "type": "string" },
        "type": { "type": "string", "enum": ["mcq", "ar", "case", "vsa2", "sa3", "la5"] },
        "marks": { "type": "number", "minimum": 1 },
        "stars": { "type": "integer", "minimum": 1, "maximum": 3 },
        "label": {
          "type": "string",
          "pattern": "^(PYQ-style|PYQ \\(20[0-9]{2}\\)|NCERT-based|SQP-style|SQP \\(20[0-9]{2}-[0-9]{2}\\))$"
        },
        "stem": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string" } },
        "answer": { "type": "string", "description": "Option key (A–D) for mcq/ar" },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["stem", "marks"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "stem": { "type": "string" },
              "options": { "type": "array", "items": { "type": "string" } },
              "answer": { "type": "string" },
              "marks": { "type": "number", "minimum": 0.5 },
              "model_answer": { "type": "string" },
              "scheme": { "$ref": "#/definitions/scheme" }
            }
          }
        },
        "model_answer": { "type": "string" },
        "scheme": { "$ref": "#/definitions/scheme" },
        "hint": { "type": "string" },
        "source_note": { "type": "string" },
        "topic": { "type": "string" },
        "internal_choice": { "type": "string", "description": "id of the alternative question when the paper offers an OR" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["mcq", "ar"] } } },
          "then": { "required": ["options", "answer"] }
        },
        {
          "if": { "properties": { "type": { "const": "case" } } },
          "then": { "required": ["parts"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["vsa2", "sa3", "la5"] } } },
          "then": { "required": ["model_answer", "scheme"] }
        }
      ]
    },
    "scheme": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "marks"],
        "additionalProperties": false,
        "properties": {
          "step": { "type": "string" },
          "marks": { "type": "number", "minimum": 0.5 }
        }
      }
    }
  }
}
